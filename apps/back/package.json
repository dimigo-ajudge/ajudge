{
  "name": "@ajudge/back",
  "version": "0.0.0",
  "description": "ajudge backend",
  "author": "lanzarote0tr <me@trillion-won.com>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "biome": "biome check --write",
    "prebuild": "npm run typecheck",
    "build": "nest build -b swc",
    "format": "biome format --write",
    "predev": "npm run db:migrate",
    "prestart:prod": "npm run db:migrate",
    "dev": "bun --watch src/main.ts",
    "start:prod": "bun dist/src/main.js",
    "lint": "biome lint --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.1.0",
    "drizzle-kit": "^1.0.0-beta",
    "drizzle-orm": "^1.0.0-beta",
    "fastify": "^5.8.2",
    "google-auth-library": "^10.6.1",
    "postgres": "^3.4.9",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@types/bun": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "@nestjs/core"
  ]
}
